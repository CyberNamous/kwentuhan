{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwentuhan",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "build": { "command": "npm run build" },
  "observability": { "enabled": false }
}
